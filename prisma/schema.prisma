generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model LocationMetric {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  latitude     Float?
  longitude    Float?
  accuracy     Float?
  status       String
  cityEstimate String?
  userAgent    String?
  createdAt    DateTime @default(now())
  ip           String?
  provider     String?

  @@map("location_metrics")
}
